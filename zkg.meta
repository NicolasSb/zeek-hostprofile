[package]
script_dir = scripts
test_command = cd testing && btest -c btest.cfg
depends = zeek >=8.0.0
summary = Per-host behavioral feature vectors over tumbling time windows.
description = Writes hostprofile_features.log: every 5 minutes, one row of
	17 features per active local host, from its connections, DNS queries
	and TLS server names (volume, diversity, novelty, failures, rhythm and
	beaconing), ready for anomaly detection or ML. Works standalone and on
	Broker or ZeroMQ clusters.
tags = anomaly detection, machine learning, feature extraction, host profiling, beaconing, intrusion detection, conn, dns, tls

[template]
source = https://github.com/zeek/package-template
version = v3.1.8
zkg_version = 3.2.0
features = github-ci,license

[template_vars]
name = HostProfile
namespace = NicolasSb
author = Nicolas Sourbier
license = bsd-3
